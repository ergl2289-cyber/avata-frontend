# Avata frontend env (NO secrets here — bot token & signature validation live on the backend)

# Toggle data source. true = local mocks, false = real Directus API.
VITE_USE_MOCKS=true

# Directus base URL (used only when VITE_USE_MOCKS=false). Set by backend (Igor).
VITE_DIRECTUS_URL=https://api.avata.site
