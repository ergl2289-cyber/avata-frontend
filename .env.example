# Avata frontend env (NO secrets here — bot token & signature validation live on the backend)

# Toggle data source. true = local mocks, false = real API.
VITE_USE_MOCKS=true

# Directus CMS (public reads: brands, models, geo, references)
VITE_DIRECTUS_URL=https://d.avata.site

# FastAPI backend (auth, cars, likes, views, reviews, profile, creation)
VITE_API_URL=https://api.avata.site
